# ─────────────────────────────────────────────────────────────────
# Environment variables for local development
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# ✗ Never commit .env.local — it's gitignored.
# ✗ Never use service account JSON keys — use ADC instead:
#     gcloud auth application-default login
# ─────────────────────────────────────────────────────────────────

# Site identity (visible in the UI and metadata)
NEXT_PUBLIC_SITE_NAME="Vamsi Thokala"
NEXT_PUBLIC_SITE_DOMAIN="vamsithokala.in"
NEXT_PUBLIC_SITE_URL="https://vamsithokala.in"

# Runtime mode
NODE_ENV="development"

# Port for local dev server
PORT="3000"
